NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000
SESSION_TTL_MINUTES=120
MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=600
DATA_DIR=./data
STORE_TRANSCRIPTS=false
API_KEY=

# OpenAI-compatible local inference endpoints. Ollama supports chat; use a
# Whisper/Faster-Whisper and Kokoro/Piper server exposing compatible routes.
ASR_BASE_URL=http://127.0.0.1:8001/v1
ASR_API_KEY=local
ASR_MODEL=whisper-1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_API_KEY=local
TTS_MODEL=kokoro
TTS_VOICE=af_heart
SYSTEM_PROMPT=You are a helpful, concise voice assistant. Speak naturally and clearly.
